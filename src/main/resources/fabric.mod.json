{
  "schemaVersion": 1,
  "id": "enderscape",
  "version": "${version}",
  "name": "Enderscape",
  "description": "Total overhaul of The End with new generation, biomes, mobs, and other features.",
  "authors": [
    "lunarbunten",
    "hivye",
    "Konci",
    "Ninni",
    "Orcinus"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/enderscape",
    "sources": "https://github.com/Penumbra-MC/Enderscape",
    "issues": "https://github.com/Penumbra-MC/Enderscape/issues"
  },
  "custom": {
    "modmenu": {
      "links": {
        "enderscape.external_link.credits": "https://github.com/Penumbra-MC/Enderscape/wiki/credits",
        "enderscape.external_link.discord": "https://discord.gg/bksj9aqqgb",
        "enderscape.external_link.wiki": "https://github.com/Penumbra-MC/Enderscape/wiki"
      }
    }
  },
  "license": "MIT",
  "icon": "assets/enderscape/icon.png",
  "environment": "*",
  "entrypoints": {
