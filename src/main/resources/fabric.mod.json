      "config": "enderscape.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "minecraft": "~26.1-",
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.154.2",
    "lithostitched": ">=1.7.13",
    "trimpatcher": ">=2.1-mc26.1-fabric",
